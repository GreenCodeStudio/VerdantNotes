<div class="ribbon">
    <section class="ribbon-tab">
        <section>
            <h3>Notes</h3>
            <button class="add-notebook-button">Utwórz notes</button>
        </section> <section>
        <h3>Strona</h3>
        <button class="add-page-button">Utwórz stronę</button>
    </section>
        <section>
            <h3>Eksport</h3>
            <a href="/VerdantPage/rtf/":page.id class="nativeLink">Download RTF</a>
            <a href="/VerdantPage/pdf/":page.id class="nativeLink">Download PDF</a>
            <a href="/VerdantPage/docx/":page.id class="nativeLink">Download Word</a>
        </section>
        <section>
            <h3>Edit</h3>
            <:if condition=canEdit>
                <button class="editBtn">Edit</button>
            </:if>
        </section>
    </section>
</div>
<article data-can-edit=canEdit class="verdantPageArticle" data-id=page.id >
    <h1>{{page.title}}</h1>
    <:foreach collection=page.nodes item=node>
        << showNode(node) >>
    </:foreach>
</article>
