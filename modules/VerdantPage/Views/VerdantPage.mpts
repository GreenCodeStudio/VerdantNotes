<div class="verdantPageWrapper">
    <div class="ribbon">
        <section class="ribbon-tab">
            <:if condition=isAuthorized >
            <section class="ribbon-notebook">
                <h3>{{t('VerdantPage.ribbon.notebook')}}</h3>
               <div>
                <button class="addNotebookButton icon-add-notebook">
                    <span>
                    {{t('VerdantPage.ribbon.notebook.add')}}
                    </span>
                </button>
                <a href="/VerdantNotebook/my" class="myMotebooksButton button icon-my-notebooks"><span>{{t('VerdantPage.ribbon.notebook.my')}}</span></a>
               </div>
            </section>
            <section>
                <h3>{{t('VerdantPage.ribbon.page')}}</h3>
                <div>
                <button class="addPageButton icon-add-page"><span>{{t('VerdantPage.ribbon.page.add')}}</span></button>

                    <:if condition=page.id >

                    <:if condition=canEdit>
                        <button class="editBtn icon-edit"><span>{{t('VerdantPage.ribbon.page.edit')}}</span></button>
                    </:if>
                    </:if>
                </div>
            </section>
            </:if>
            <:if condition=page.id >
                <section>
                    <h3>{{t('VerdantPage.ribbon.export')}}</h3>
                    <div>
                        <a href="/VerdantPage/rtf/":page.id class="nativeLink button icon-download-rtf"><span>{{t('VerdantPage.ribbon.export.rtf')}}</span></a>
                        <a href="/VerdantPage/pdf/":page.id class="nativeLink button icon-download-pdf"><span>{{t('VerdantPage.ribbon.export.pdf')}}</span></a>
                        <a href="/VerdantPage/docx/":page.id class="nativeLink button icon-download-docx"><span>{{t('VerdantPage.ribbon.export.word')}}</span></a>
                        <a href="/VerdantPage/md/":page.id class="nativeLink button icon-download-md"><span>{{t('VerdantPage.ribbon.export.markdown')}}</span></a>
                    </div>
                </section>
            </:if>
            <section>
                <h3>{{t('VerdantPage.ribbon.help')}}</h3>
                <div>
                <a href="/VerdantPage/show/f603d4af-11a9-4174-a824-4078520042cc" class="button icon-about">{{t('VerdantPage.ribbon.help.about')}}</a>
                </div>
            </section>
        </section>
    </div>
    <article data-can-edit=canEdit class="verdantPageArticle" data-id=page.id data-notebook-id=page.notebook_id>
        <h1>{{page.title}}</h1>
        <:foreach collection=page.nodes item=node>
            << showNode(node) >>
        </:foreach>
    </article>
    <aside>
        <h1>
            {{noName(page.notebook_name , 'Notes bez nazwy')}}
        </h1>
        <ul>
            <:foreach collection=page.notebookPages item=notebookPage>
                <li>
                    <a href="/VerdantPage/show/":notebookPage.id  class="asidePageLink" data-id=notebookPage.id >
                                          {{noName(notebookPage.title , 'Strona bez nazwy')}}
                                   </a>
                </li>
            </:foreach>
        </ul>
    </aside>
</div>
