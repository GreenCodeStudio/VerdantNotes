<div class="verdantPageWrapper">
    <div class="ribbon">
        <section class="ribbon-tab">
            <:if condition=isAuthorized >
            <section>
                <h3>Notes</h3>
                <div>
                <button class="addNotebookButton">Utwórz notes</button>
                <a href="/VerdantNotebook/my" class="myMotebooksButton button">Moje notesy</a>
                </div>
            </section>
                <section>
                    <h3>Strona</h3>
                    <div>
                    <button class="addPageButton">Utwórz stronę</button>
                    </div>
                </section>
            </:if>
            <section>
                <h3>Help</h3>
                <div>
                <a href="/VerdantPage/show/f603d4af-11a9-4174-a824-4078520042cc" class="button">About</a>
                </div>
            </section>
        </section>
    </div>
    <article class="noArticle"  data-notebook-id=notebook.id >

    </article>
    <aside>
        <h1>
            {{noName(notebook.name , 'Notes bez nazwy')}}
        </h1>
        <ul>
            <:foreach collection=notebook.pages item=notebookPage>
                <li>
                    <a href="/VerdantPage/show/":notebookPage.id >
                                          {{notebookPage.title}}
                                   </a>
                </li>
            </:foreach>
        </ul>
    </aside>
</div>
